{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 2,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " 󰄾 ",
    "color": {
      "separator": "38;2;86;95;137"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{#38;2;192;202;245}╭─ {user-name}@{host-name}{#}"
    },
    {
      "type": "os",
      "key": "{#38;2;192;202;245}├─ {#38;2;158;206;106}{#}"
    },
    {
      "type": "kernel",
      "key": "{#38;2;192;202;245}├─ {#38;2;122;162;247}{#}"
    },
    {
      "type": "uptime",
      "key": "{#38;2;192;202;245}├─ {#38;2;224;175;104}󰅐{#}"
    },
    {
      "type": "loadavg",
      "key": "{#38;2;192;202;245}├─ {#38;2;224;175;104}󰊚{#}"
    },
    {
      "type": "packages",
      "key": "{#38;2;192;202;245}├─ {#38;2;187;154;247}󰏖{#}"
    },
    {
      "type": "wm",
      "key": "{#38;2;192;202;245}├─ {#38;2;125;207;255}󱂬{#}"
    },
    {
      "type": "terminal",
      "key": "{#38;2;192;202;245}├─ {#38;2;122;162;247}{#}"
    },
    {
      "type": "cpu",
      "key": "{#38;2;192;202;245}├─ {#38;2;158;206;106}{#}"
    },
    {
      "type": "gpu",
      "key": "{#38;2;192;202;245}├─ {#38;2;125;207;255}󰢮{#}"
    },
    {
      "type": "memory",
      "key": "{#38;2;192;202;245}├─ {#38;2;224;175;104}󰘚{#}"
    },
    {
      "type": "disk",
      "key": "{#38;2;192;202;245}├─ {#38;2;187;154;247}󰋊{#}"
    },
    {
      "type": "colors",
      "key": "{#38;2;192;202;245}╰─ {#38;2;122;162;247}󰏘{#}",
      "symbol": "circle"
    }
  ]
}
